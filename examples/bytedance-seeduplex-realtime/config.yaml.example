# === 3CX PBX ===
appId: your-3cx-app-id
appSecret: your-3cx-app-secret
pbxBase: https://your-pbx.3cx.eu:5001

# === Volcengine / ByteDance Seeduplex 3.0 (text JSON duplex) ===
# Obtain APP ID and API Key from the Volcengine Doubao speech console.
# 3.0 duplex access may require invitation / enablement. 403 must not be
# "fixed" by falling back to the 1.0 binary endpoint.
# Optional compatibility header; the official 3.0 demo requires only API Key.
# volcAppId: your-volcengine-app-id
volcApiKey: your-volcengine-api-key

# Model is a version string, not a free-form alias. Default: 1.2.6.0
realtimeModel: "1.2.6.0"
# Fallback voice; agent profile voice takes priority
realtimeVoice: zh_female_vv_jupiter_bigtts

# === Agent profile ===
agentProfile: receptionist_cn
companyName: "Your Company"
agentName: "小助手"

initialGreeting: 您好，请问有什么可以帮您？

speakOnRouteFailure: true
routeFailureUserReply: 暂时无法完成转接，请稍候或稍后再拨。

customMcpServers:
   # Remote MCP server (bearer auth)
   - name: GoogleCalendar
     url: https://mcp.example.com/your-server
     auth:
       type: bearer
       token: your-mcp-bearer-token
     enabled: true

   # Local MCP server (no auth)
   - name: LocalTools
     url: http://localhost:3001/mcp
     auth:
       type: none
     enabled: true

   # OAuth machine-to-machine (no operator interaction). The MCP server must
   # advertise RFC 9728 / RFC 8414 metadata. Do not commit token-store files.
   # - name: ServiceCrm
   #   url: https://mcp.example.com/mcp
   #   auth:
   #     type: oauth
   #     grant: client_credentials
   #     clientId: your-client-id
   #     clientSecret: your-client-secret
   #     scope: "mcp:tools"
   #   enabled: true

   # OAuth authorization code. Provision once, then start the agent:
   #   yarn mcp:auth --config examples/bytedance-seeduplex-realtime/config.yaml GoogleWorkspace
   # - name: GoogleWorkspace
   #   url: https://mcp.example.com/mcp
   #   auth:
   #     type: oauth
   #     grant: authorization_code
   #     clientId: your-client-id
   #     clientSecret: your-client-secret
   #     redirectUri: http://127.0.0.1:8765/callback
   #     tokenStore: .mcp-tokens/googleworkspace.json
   #     scope: "mcp:tools"
   #   enabled: true
